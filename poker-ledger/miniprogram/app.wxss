/** 全局样式：尽量贴近 iOS 常见 App 的清爽风格 */
page {
  background: #F2F2F7;
  color: #1C1C1E;
  font-size: 32rpx;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  width: 100vw;
  min-height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  /* width: 100vw; */
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.06);

}

.card+.card {
  /* margin-top: 18rpx;
  margin-bottom: 18rpx; */
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.subtle {
  color: #8E8E93;
  font-size: 26rpx;
}

.btn-primary {
  background: #007AFF;
  color: #FFFFFF;
  border-radius: 16rpx;
}

.btn-danger {
  background: #FF3B30;
  color: #FFFFFF;
  border-radius: 16rpx;
  width: 100%;
  height: 80rpx;
  font-size: 36rpx !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
}

.btn-plain {
  background: #FFFFFF;
  color: #007AFF;
  border: 2rpx solid rgba(0, 122, 255, 0.35);
  border-radius: 16rpx;
}

.input {
  background: #F2F2F7;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 32rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
