/** 全局样式：尽量贴近 iOS 常见 App 的清爽风格 */
page {
  background: #F7F2E9;
  color: #1E2F2A;
  font-size: 32rpx;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  width: 100vw;
  min-height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background: rgba(255, 253, 248, 0.96);
  border: 2rpx solid rgba(33, 93, 77, 0.11);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(24, 69, 57, 0.08);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1E2F2A;
}

.subtle {
  color: #687974;
  font-size: 26rpx;
  line-height: 1.45;
}

.btn-primary {
  background: linear-gradient(135deg, #2E8B73 0%, #1F6C59 100%);
  color: #F8F3E7;
  border-radius: 18rpx;
  border: none;
  font-weight: 700;
}

/* 统一禁用态可读性：避免深色底上的低对比文字 */
.btn-primary[disabled] {
  background: linear-gradient(135deg, #A8CABC 0%, #90B8A8 100%);
  color: rgba(30, 47, 42, 0.62);
  opacity: 1;
}

.btn-danger {
  background: #C93B2E;
  color: #FFFFFF;
  border-radius: 18rpx;
  border: none;
  width: 100%;
  height: 80rpx;
  font-size: 36rpx !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
}

.btn-plain {
  background: rgba(255, 255, 255, 0.82);
  color: #236F5D;
  border: 2rpx solid rgba(35, 111, 93, 0.32);
  border-radius: 18rpx;
}

.input {
  background: #F2ECDD;
  border: 2rpx solid rgba(35, 111, 93, 0.14);
  border-radius: 18rpx;
  padding: 20rpx;
  font-size: 32rpx;
  color: #1E2F2A;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
