/** 全局样式：尽量贴近 iOS 常见 App 的清爽风格 */
page {
  background: #F7F2E9;
  color: #1E2F2A;
  font-size: 32rpx;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  width: 100vw;
  min-height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background: rgba(255, 253, 248, 0.96);
  border: 2rpx solid rgba(33, 93, 77, 0.11);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(24, 69, 57, 0.08);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1E2F2A;
}

.subtle {
  color: #687974;
  font-size: 26rpx;
  line-height: 1.45;
}

.btn-primary {
  background: linear-gradient(135deg, #2E8B73 0%, #1F6C59 100%);
  color: #F8F3E7;
  border-radius: 18rpx;
  /* 与 .btn-plain 的 2rpx 边框对齐：否则并排时主按钮会比次按钮矮 2px、窄 2px */
  border: 2rpx solid transparent;
  font-weight: 700;
}

/* 统一禁用态可读性：避免深色底上的低对比文字 */
.btn-primary[disabled] {
  background: linear-gradient(135deg, #A8CABC 0%, #90B8A8 100%);
  color: rgba(30, 47, 42, 0.62);
  opacity: 1;
}

.btn-danger {
  background: #C93B2E;
  color: #FFFFFF;
  border-radius: 18rpx;
  border: none;
  width: 100%;
  height: 80rpx;
  font-size: 36rpx !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
}

.btn-plain {
  background: rgba(255, 255, 255, 0.82);
  color: #236F5D;
  border: 2rpx solid rgba(35, 111, 93, 0.32);
  border-radius: 18rpx;
}

.input {
  background: #F2ECDD;
  border: 2rpx solid rgba(35, 111, 93, 0.14);
  border-radius: 18rpx;
  /* 微信原生 input 自带内建行高。改成 border-box 后，若只写 height，
     竖向 padding 会把内容区吃光，表现为输入框变扁、文字上下被裁。
     所以：border-box 解决 width:100% 撑破容器；min-height 保证总高度足够；
     竖向 padding 保留（它负责文字垂直居中，是被验证过能正常显示的方案）。 */
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 20rpx;
  font-size: 32rpx;
  color: #1E2F2A;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

/* 统一盒模型：这些元素同时设置了 width:100% 和 padding/border，
 * 小程序的默认盒模型是 content-box，会把它们在右侧撑出容器（表现为左右内边距不对称、贴边、被裁切）。
 * 注意：.input 单独在下面处理，它还需要 min-height 保证高度，不能只靠这一条。 */
.card,
.overlay-card,
.btn-primary,
.btn-plain {
  box-sizing: border-box;
}

/* ---------- 环境标识（首页 / 房间 / 我的 共用） ---------- */

.env-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.4;
  background: rgba(46, 139, 115, 0.1);
  color: #236F5D;
  flex-shrink: 0;
}

.env-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: currentColor;
  opacity: 0.7;
}

.env-text {
  color: inherit;
  white-space: nowrap;
}

/* 本地开发（开发者工具模拟器） */
.env-pill--dev {
  background: #F7DCB0;
  color: #5A3A08;
}

/* 开发版（真机预览 / 真机调试） */
.env-pill--develop {
  background: #D3E9FA;
  color: #123B5C;
}

/* 体验版 */
.env-pill--trial {
  background: #E6D7F7;
  color: #3A1A5E;
}

/* 正式版 */
.env-pill--release {
  background: #E1F0EA;
  color: #1D5C4B;
}

