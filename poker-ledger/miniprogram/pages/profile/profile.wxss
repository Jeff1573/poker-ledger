.profile-page {
  height: calc(100vh - 48rpx - constant(safe-area-inset-bottom));
  height: calc(100vh - 48rpx - env(safe-area-inset-bottom));
  overflow: hidden;
}

.profile-container {
  height: 100%;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ---------- 环境标识（配色见 app.wxss 全局 .env-pill--* ） ---------- */

.env-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.env-host {
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  line-height: 1.4;
  color: #8A9893;
  word-break: break-all;
}

/* ---------- 开发账号 ---------- */

.dev-row {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(46, 139, 115, 0.06);
  border: 2rpx dashed rgba(35, 111, 93, 0.24);
}

.dev-info {
  flex: 1;
  min-width: 0;
}

.dev-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #236F5D;
}

.dev-hint {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8A9893;
  line-height: 1.4;
}

.dev-switch {
  margin-left: 14rpx;
  flex-shrink: 0;
}

/* ---------- 身份 / 资料 ---------- */

.identity-row {
  display: flex;
  align-items: center;
}

.identity-avatar {
  margin-right: 20rpx;
}

.identity-main {
  min-width: 0;
  flex: 1;
}

.identity-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1E2F2A;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E2F2A;
}

.identity-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E2F2A;
}

.identity-hint {
  margin-top: 8rpx;
  color: #687974;
  font-size: 24rpx;
  line-height: 1.45;
}

.setup-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}

.avatar-trigger {
  flex-shrink: 0;
  width: 132rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-trigger::after {
  border: none;
}

.avatar-trigger-text {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #236F5D;
  font-weight: 600;
  line-height: 1.3;
}

.setup-fields {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.setup-input {
  width: 100%;
}

.setup-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A9893;
  line-height: 1.4;
}

.setup-save {
  margin-top: 22rpx;
}

/* ---------- 注销 ---------- */

.danger-zone {
  margin-top: 8rpx;
  padding-bottom: 20rpx;
}

.logout-btn {
  background: rgba(201, 59, 46, 0.06);
  color: #C93B2E;
  border: 2rpx solid rgba(201, 59, 46, 0.24);
  box-shadow: none;
}

.danger-tip {
  margin-top: 10rpx;
  text-align: center;
  font-size: 21rpx;
  color: #8A9893;
}
