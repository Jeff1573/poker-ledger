.profile-page {
  height: calc(100vh - 48rpx - constant(safe-area-inset-bottom));
  height: calc(100vh - 48rpx - env(safe-area-inset-bottom));
  overflow: hidden;
}

.profile-container {
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.profile-row {
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #E8E1D2;
  border: 2rpx solid rgba(35, 111, 93, 0.16);
}

.name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1E2F2A;
}

.history-card {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.history-scroll {
  margin-top: 18rpx;
  flex: 1;
  min-height: 0;
}

.history-scroll-inner {
  min-height: 100%;
  display: flex;
  flex-direction: column;
}

.history-list {
  flex-shrink: 0;
}

.history-item {
  padding: 16rpx 0;
  border-bottom: 2rpx solid rgba(60, 60, 67, 0.12);
}

.history-list .history-item:last-child {
  border-bottom: none;
}

.history-room {
  font-size: 30rpx;
  font-weight: 600;
}

.history-amount {
  font-size: 32rpx;
  font-weight: 700;
}

.plus {
  color: #34C759;
}

.minus {
  color: #FF3B30;
}

.zero {
  color: #8E8E93;
}

.history-footer {
  margin-top: 12rpx;
  text-align: center;
}

.history-bottom-spacer {
  height: calc(24rpx + constant(safe-area-inset-bottom));
  height: calc(24rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
}

.overlay-card {
  width: 100%;
  max-width: 640rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
}

.item-row {
  padding: 14rpx 0;
  border-bottom: 2rpx solid rgba(60, 60, 67, 0.12);
}

.item-row:last-child {
  border-bottom: none;
}

.mini-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #E5E5EA;
}

.name-wrap {
  margin-left: 14rpx;
}

.badge {
  display: inline-block;
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: rgba(0, 122, 255, 0.12);
  color: #007AFF;
}
