<view class="profile-page">
  <view class="container profile-container">
    <view class="card">
      <view class="title">我的资料</view>
      <view class="subtle" style="margin-top: 10rpx;">默认使用微信头像昵称，可修改展示昵称</view>

      <view wx:if="{{hasProfile}}" class="row profile-row" style="margin-top: 22rpx;">
        <image class="avatar" src="{{userAvatarUrl}}" mode="aspectFill" />
        <view style="margin-left: 18rpx;">
          <view class="name">{{user.displayName}}</view>
          <view class="subtle">微信昵称：{{user.nickNameWx}}</view>
        </view>
      </view>

      <view wx:else class="row-between" style="margin-top: 22rpx;">
        <view>
          <view class="name">尚未授权</view>
          <view class="subtle">请先授权获取头像昵称</view>
        </view>
        <button class="btn-primary" bindtap="handleOpenProfileModal" disabled="{{loading}}">去授权</button>
      </view>
    </view>

    <view class="card" wx:if="{{hasProfile}}">
      <view class="title">修改昵称</view>
      <input
        class="input"
        placeholder="请输入新昵称"
        value="{{displayNameInput}}"
        bindinput="handleDisplayNameInput"
        maxlength="20"
        style="margin-top: 18rpx;"
      />
      <button class="btn-primary" style="margin-top: 18rpx;" bindtap="handleSave" disabled="{{loading}}">
        保存
      </button>
    </view>

    <view class="card history-card" wx:if="{{hasProfile}}">
      <view class="row-between">
        <view class="title">牌局时间线</view>
        <picker mode="selector" range="{{scopeOptions}}" value="{{scheduleScopeIndex}}" bindchange="handleScopeChange">
          <view class="scope-picker">{{currentScopeLabel}} ▾</view>
        </picker>
      </view>
      <view class="subtle" style="margin-top: 10rpx;">按时间查看每局全员输赢，默认展示前 3 人</view>

      <view wx:if="{{timelineLoading}}" class="subtle" style="margin-top: 18rpx;">加载中...</view>

      <view wx:elif="{{timelineError}}" style="margin-top: 18rpx;">
        <view class="subtle">{{timelineError}}</view>
        <button class="btn-plain" style="margin-top: 14rpx;" bindtap="loadTimelineFirstPage">重试</button>
      </view>

      <view wx:elif="{{timelineRows.length === 0}}" class="subtle" style="margin-top: 18rpx;">暂无时间线记录</view>

      <scroll-view
        wx:else
        class="history-scroll"
        scroll-y
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
        lower-threshold="120"
        bindscrolltolower="handleTimelineReachBottom"
      >
        <view class="history-scroll-inner">
          <view class="timeline-list">
            <view wx:for="{{timelineGroups}}" wx:key="year" class="timeline-year-group">
              <view class="timeline-year-header">
                <view class="timeline-year-dot"></view>
                <view class="timeline-year-text">{{item.year}}</view>
              </view>

              <view class="timeline-year-body">
                <view wx:for="{{item.rows}}" wx:for-item="row" wx:key="settlementId" class="timeline-item">
                  <view class="timeline-rail">
                    <view class="timeline-node"></view>
                  </view>

                  <view class="timeline-content">
                    <view class="row-between timeline-head">
                      <view class="timeline-main">{{row.dissolvedAtText}} 房:{{row.roomCode}}</view>
                      <view class="timeline-status {{row.statusClass}}">{{row.statusText}}</view>
                    </view>

                    <view class="subtle timeline-meta">交易 {{row.txCount}} 笔 · {{row.memberCount}} 人</view>

                    <view class="timeline-members">
                      <view
                        wx:for="{{expandedSettleIds[row.settlementId] ? row.members : row.previewMembers}}"
                        wx:for-item="member"
                        wx:key="openId"
                        class="row-between timeline-member-line"
                      >
                        <view class="timeline-member-left">
                          <text class="timeline-member-name">{{member.displayName}}</text>
                          <text wx:if="{{member.role === 'owner'}}" class="timeline-member-tag">房主</text>
                          <text wx:if="{{member.active === false}}" class="timeline-member-exit">已退出</text>
                        </view>
                        <view class="timeline-member-amount {{member.amountClass}}">{{member.amountText}}</view>
                      </view>
                    </view>

                    <view
                      wx:if="{{row.hiddenMemberCount > 0}}"
                      class="timeline-expand"
                      bindtap="handleToggleItemExpand"
                      data-settlementid="{{row.settlementId}}"
                    >
                      {{expandedSettleIds[row.settlementId] ? '收起成员' : ('展开其余 ' + row.hiddenMemberCount + ' 人')}}
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <view wx:if="{{timelineLoadingMore}}" class="history-footer subtle">加载中...</view>
          <view wx:elif="{{!timelineHasMore}}" class="history-footer subtle">没有更多记录了</view>
          <view class="history-bottom-spacer"></view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>

<!-- 资料授权弹窗：与首页授权流程保持一致 -->
<view wx:if="{{showProfileModal}}" class="overlay" bindtap="handleCloseProfileModal">
  <view class="overlay-card profile-modal-card" catchtap="noop">
    <view class="title">完善资料</view>
    <view class="subtle" style="margin-top: 10rpx;">用于房间内展示头像和昵称，完成后即可创建或加入房间</view>

    <view wx:if="{{supportChooseAvatar}}">
      <view class="row profile-modal-avatar-row">
        <image class="avatar" src="{{draftAvatarLocal}}" mode="aspectFill" />
        <button class="btn-plain auth-btn" open-type="chooseAvatar" bindchooseavatar="handleChooseAvatar" disabled="{{loading}}">
          选择头像
        </button>
      </view>

      <input
        class="input"
        type="nickname"
        placeholder="请输入昵称"
        value="{{draftDisplayName}}"
        bindinput="handleNicknameInput"
        maxlength="20"
        style="margin-top: 14rpx;"
      />

      <view class="row profile-modal-actions">
        <button class="btn-plain" style="flex: 1;" bindtap="handleCloseProfileModal" disabled="{{loading}}">
          取消
        </button>
        <button
          class="btn-primary"
          style="flex: 1; margin-left: 14rpx;"
          bindtap="handleSaveAuthProfile"
          disabled="{{!canSaveProfile || loading}}"
        >
          保存并授权
        </button>
      </view>
    </view>

    <view wx:else>
      <view class="subtle" style="margin-top: 18rpx;">当前设备不支持直接选择头像，请使用授权方式获取资料。</view>
      <view class="row profile-modal-actions">
        <button class="btn-plain" style="flex: 1;" bindtap="handleCloseProfileModal" disabled="{{loading}}">
          取消
        </button>
        <button class="btn-primary" style="flex: 1; margin-left: 14rpx;" bindtap="handleAuthLegacy" disabled="{{loading}}">
          授权获取
        </button>
      </view>
    </view>
  </view>
</view>
