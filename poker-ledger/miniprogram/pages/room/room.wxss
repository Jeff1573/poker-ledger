page {
  height: 100vh;
  overflow: hidden;
}

.container.room {
  height: 100%;
  min-height: 0;
}

.room-tab-page {
  justify-content: flex-start;
}

.room-state-card {
  margin-top: 10rpx;
  padding: 28rpx 24rpx;
}

.room-state-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1E2F2A;
}

.room-state-subtle {
  margin-top: 12rpx;
}

.room-state-btn {
  margin-top: 24rpx;
}

.room-info-card {
  /* 房间信息卡固定最小高度，避免 loading 与内容切换时高度抖动 */
  min-height: 224rpx;
  box-sizing: border-box;
}

/* 房间信息卡 loading 骨架 */
.room-info-skeleton {
  min-height: 176rpx;
}

.room-info-skeleton-main {
  flex: 1;
  min-width: 0;
}

.room-skeleton-line {
  position: relative;
  overflow: hidden;
  border-radius: 12rpx;
  background: #E8E1D2;
}

.room-skeleton-line::after {
  content: "";
  position: absolute;
  top: 0;
  left: -150%;
  width: 120%;
  height: 100%;
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.56) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  animation: room-info-skeleton-shimmer 1.2s ease-in-out infinite;
}

.room-info-skeleton-title {
  width: 220rpx;
  height: 38rpx;
}

.room-info-skeleton-role {
  margin-top: 10rpx;
  width: 150rpx;
  height: 24rpx;
}

.room-info-skeleton-copy {
  width: 86rpx;
  height: 58rpx;
  border-radius: 18rpx;
  margin-left: 16rpx;
}

.room-info-skeleton-actions {
  margin-top: 18rpx;
}

.room-info-skeleton-action {
  flex: 1;
  height: 76rpx;
  border-radius: 18rpx;
}

.room-info-skeleton-action-gap {
  margin-left: 14rpx;
}

@keyframes room-info-skeleton-shimmer {
  0% {
    left: -150%;
  }

  100% {
    left: 160%;
  }
}

.room-frame-card {
  transition: opacity 120ms ease;
}

.room-frame-disabled {
  opacity: 0.68;
}

.member-list-disabled {
  pointer-events: none;
}

.room-placeholder {
  text-align: center;
  padding: 18rpx 0;
}

/* tx-card 占据剩余空间,使用 flex 布局 */
.tx-card {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 0; /* 重要:允许 flex 子元素收缩 */
}

/* scroll-view 占据剩余空间,启用滚动 */
.tx-card .tx-list {
  flex: 1;
  min-height: 0; /* 重要:允许 scroll-view 在 flex 中正确收缩 */
}

/* 隐藏滚动条 */
.tx-card .tx-list::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

/* scroll-view 内部容器,使用内边距代替 scroll-view 外边距 */
.tx-list-container {
  padding-top: 18rpx;
  padding-bottom: 48rpx;
}

.tx-list-footer {
  text-align: center;
  color: #687974;
  font-size: 24rpx;
  padding: 16rpx 0 8rpx;
}

.tx-list-footer-error {
  color: #C93B2E;
}

.action-row button {
  height: 76rpx;
  line-height: 76rpx;
}

.action-btn {
  flex: 1;
}

.action-btn-gap {
  margin-left: 14rpx;
}

.member-scroll {
  white-space: nowrap;
}

.member-list {
  /* 人数较少时也能居中显示；超出容器宽度时保持横向滚动 */
  display: inline-flex;
  min-width: 100%;
  flex-direction: row;
  align-items: flex-start;
  justify-content: center;
}

.member-item {
  width: 140rpx;
  margin-right: 18rpx;
  position: relative;
  text-align: center;
}

.member-item:last-child {
  margin-right: 0;
}

.member-count {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #F2ECDD;
  color: #2F413C;
  font-weight: 600;
  line-height: 1.1;
}

.member-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 100rpx;
  background: #E8E1D2;
  /* 头像中心线与昵称/金额文字中心线保持一致 */
  margin: 0 auto;
}

.member-name {
  margin-top: 10rpx;
  font-size: 26rpx;
  text-align: center;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.member-amount {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.2;
}

.inactive {
  opacity: 0.55;
}

.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(35, 111, 93, 0.28);
  color: #236F5D;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 2;
}

.badge-gray {
  border-color: rgba(104, 121, 116, 0.28);
  color: #687974;
}

.total-row {
  padding: 14rpx 0;
  border-bottom: 2rpx solid rgba(60, 60, 67, 0.12);
}

.total-row:last-child {
  border-bottom: none;
}

.total-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #E8E1D2;
}

.total-name {
  margin-left: 14rpx;
  font-size: 30rpx;
}

.total-amount {
  font-size: 32rpx;
  font-weight: 600;
}

.plus {
  color: #2E8B73;
}

.minus {
  color: #C93B2E;
}

.zero {
  color: #687974;
}

.tx-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(60, 60, 67, 0.12);
  display: flex;
  align-items: center;
}

.tx-item:last-child {
  border-bottom: none;
}

.tx-peer {
  flex: 1;
  min-width: 0;
}

.tx-body {
  flex: 1;
  min-width: 0;
}

.tx-main {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E2F2A;
  line-height: 1.4;
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.tx-inline-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #E8E1D2;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.tx-name {
  flex-shrink: 0;
}

.tx-arrow {
  color: #687974;
  margin: 0 8rpx;
  flex-shrink: 0;
}

.tx-amount {
  margin-left: 24rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #C93B2E;
  flex-shrink: 0;
}

.tx-income {
  color: #C93B2E;
}

.tx-expense {
  color: #2E8B73;
}

.tx-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #E8E1D2;
  flex-shrink: 0;
}

.transfer-name {
  font-size: 32rpx;
  font-weight: 600;
}

/* 入房码弹层 */
.overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
}

.overlay-card {
  width: 100%;
  max-width: 640rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
}

.qrcode {
  width: 100%;
  height: 540rpx;
  margin-top: 18rpx;
  border-radius: 18rpx;
}

.join-code-tip {
  margin-top: 12rpx;
  text-align: center;
  line-height: 1.5;
}

.join-code-tip-error {
  color: #C93B2E;
}

.share-guide-card .title {
  text-align: center;
}
