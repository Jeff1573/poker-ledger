page {
  height: 100vh;
  overflow: hidden;
}

.container.room {
  height: 100%;
  min-height: 0;
}

/* tx-card 占据剩余空间,使用 flex 布局 */
.tx-card {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 0; /* 重要:允许 flex 子元素收缩 */
}

/* scroll-view 占据剩余空间,启用滚动 */
.tx-card .tx-list {
  flex: 1;
  min-height: 0; /* 重要:允许 scroll-view 在 flex 中正确收缩 */
}

/* 隐藏滚动条 */
.tx-card .tx-list::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

/* scroll-view 内部容器,使用内边距代替 scroll-view 外边距 */
.tx-list-container {
  padding-top: 18rpx;
  padding-bottom: 48rpx;
}

.action-row button {
  height: 76rpx;
  line-height: 76rpx;
}

.action-btn {
  flex: 1;
}

.action-btn-gap {
  margin-left: 14rpx;
}

.member-scroll {
  white-space: nowrap;
}

.member-list {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.member-item {
  width: 140rpx;
  margin-right: 18rpx;
  position: relative;
}

.member-count {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #F2F2F7;
  color: #3A3A3C;
  font-weight: 600;
  line-height: 1.1;
}

.member-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 100rpx;
  background: #E5E5EA;
}

.member-name {
  margin-top: 10rpx;
  font-size: 26rpx;
  text-align: center;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.member-amount {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.2;
}

.inactive {
  opacity: 0.55;
}

.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(0, 122, 255, 0.28);
  color: #007AFF;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 2;
}

.badge-gray {
  border-color: rgba(142, 142, 147, 0.28);
  color: #8E8E93;
}

.total-row {
  padding: 14rpx 0;
  border-bottom: 2rpx solid rgba(60, 60, 67, 0.12);
}

.total-row:last-child {
  border-bottom: none;
}

.total-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #E5E5EA;
}

.total-name {
  margin-left: 14rpx;
  font-size: 30rpx;
}

.total-amount {
  font-size: 32rpx;
  font-weight: 600;
}

.plus {
  color: #34C759;
}

.minus {
  color: #FF3B30;
}

.zero {
  color: #8E8E93;
}

.tx-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(60, 60, 67, 0.12);
  display: flex;
  align-items: center;
}

.tx-item:last-child {
  border-bottom: none;
}

.tx-peer {
  flex: 1;
  min-width: 0;
}

.tx-body {
  flex: 1;
  min-width: 0;
}

.tx-main {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1E;
  line-height: 1.4;
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.tx-inline-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #E5E5EA;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.tx-name {
  flex-shrink: 0;
}

.tx-arrow {
  color: #8E8E93;
  margin: 0 8rpx;
  flex-shrink: 0;
}

.tx-amount {
  margin-left: 24rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #FF3B30;
  flex-shrink: 0;
}

.tx-income {
  color: #FF3B30;
}

.tx-expense {
  color: #34C759;
}

.transfer-name {
  font-size: 32rpx;
  font-weight: 600;
}

/* 入房码弹层 */
.overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
}

.overlay-card {
  width: 100%;
  max-width: 640rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
}

.qrcode {
  width: 100%;
  height: 540rpx;
  margin-top: 18rpx;
  background: #F2F2F7;
  border-radius: 18rpx;
}

.share-guide-card .title {
  text-align: center;
}
