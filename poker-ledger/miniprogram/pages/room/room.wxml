<view class="container room room-tab-page">
  <view wx:if="{{viewState !== 'in_room'}}" class="card room-state-card">
    <view class="room-state-title" wx:if="{{viewState === 'no_profile'}}">请先在首页授权资料</view>
    <view class="room-state-title" wx:elif="{{viewState === 'no_room'}}">你还未加入房间</view>
    <view class="room-state-title" wx:else>房间加载中</view>

    <view class="subtle room-state-subtle" wx:if="{{viewState === 'no_profile'}}">
      授权完成后即可在房间页进行成员记账与交易操作。
    </view>
    <view class="subtle room-state-subtle" wx:elif="{{viewState === 'no_room'}}">
      请先前往首页创建或加入房间，再返回这里查看实时账单。
    </view>
    <view class="subtle room-state-subtle" wx:else>
      正在同步你的房间状态...
    </view>

    <button wx:if="{{viewState === 'no_profile'}}" class="btn-primary room-state-btn" bindtap="handleGoHomeTab">
      去首页授权
    </button>
    <button wx:elif="{{viewState === 'no_room'}}" class="btn-primary room-state-btn" bindtap="handleGoHomeTab">
      去首页创建/加入
    </button>
  </view>

  <!-- 房间信息 -->
  <view class="card room-frame-card room-info-card {{viewState !== 'in_room' ? 'room-frame-disabled' : ''}}">
    <!-- 房间信息卡骨架：loading 时在卡片内部占位，避免内容切换闪烁 -->
    <block wx:if="{{viewState === 'loading'}}">
      <view class="room-info-skeleton" aria-label="房间信息加载中">
        <view class="row-between">
          <view class="room-info-skeleton-main">
            <view class="room-skeleton-line room-info-skeleton-title"></view>
            <view class="room-skeleton-line room-info-skeleton-role"></view>
          </view>
          <view class="room-skeleton-line room-info-skeleton-copy"></view>
        </view>
        <view class="row room-info-skeleton-actions">
          <view class="room-skeleton-line room-info-skeleton-action"></view>
          <view class="room-skeleton-line room-info-skeleton-action room-info-skeleton-action-gap"></view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="row-between">
        <view>
          <view class="title" wx:if="{{viewState === 'in_room'}}">房间 {{roomCode}}</view>
          <view class="title" wx:else>房间 --</view>
          <view class="subtle" style="margin-top: 10rpx;" wx:if="{{viewState === 'in_room'}}">角色：{{roleText}}</view>
          <view class="subtle" style="margin-top: 10rpx;" wx:else>角色：未加入</view>
          <view class="subtle room-refresh-tip" wx:if="{{viewState === 'in_room' && isRefreshing}}">
            后台同步中...
          </view>
        </view>
        <button class="btn-plain" size="mini" bindtap="copyRoomCode" disabled="{{viewState !== 'in_room'}}">
          复制
        </button>
      </view>

      <view wx:if="{{viewState === 'in_room' && role === 'owner'}}" class="row action-row" style="margin-top: 18rpx;">
        <button wx:if="{{false}}" class="btn-plain action-btn" bindtap="handleShowJoinCode" disabled="{{isJoinCodeLoading}}">
          入房码
        </button>
        <button class="btn-primary action-btn" bindtap="handleShareByMenuTip" disabled="{{isJoinCodeLoading}}">
          分享邀请
        </button>
        <button class="btn-danger action-btn action-btn-gap" bindtap="handleDissolve" disabled="{{isDissolving}}">
          解散房间
        </button>
      </view>

      <view wx:elif="{{viewState === 'in_room'}}" class="row action-row" style="margin-top: 18rpx;">
        <button class="btn-primary action-btn" bindtap="handleShareByMenuTip" disabled="{{isJoinCodeLoading}}">
          分享邀请
        </button>
        <button class="btn-danger action-btn action-btn-gap" bindtap="handleLeave" disabled="{{isLeaving}}">
          退出房间
        </button>
      </view>

      <view wx:else class="row action-row" style="margin-top: 18rpx;">
        <button class="btn-primary action-btn" disabled="{{true}}">分享邀请</button>
        <button class="btn-danger action-btn action-btn-gap" disabled="{{true}}">房间操作</button>
      </view>
    </block>
  </view>

  <!-- 成员列表 -->
  <view class="card room-frame-card {{viewState !== 'in_room' ? 'room-frame-disabled' : ''}}">
    <view class="row-between">
      <view class="title">成员</view>
      <view class="subtle member-count">{{members.length}} 人</view>
    </view>
    <view class="subtle" style="margin-top: 10rpx;" wx:if="{{viewState === 'in_room'}}">点击成员头像进行转账记账</view>
    <view class="subtle" style="margin-top: 10rpx;" wx:else>授权并加入房间后，可查看成员并发起转账。</view>

    <scroll-view scroll-x show-scrollbar="{{false}}" class="member-scroll" style="margin-top: 18rpx;">
      <view class="member-list {{viewState !== 'in_room' ? 'member-list-disabled' : ''}}">
        <view
          wx:for="{{members}}"
          wx:key="openId"
          class="member-item {{item.role === 'owner' ? 'owner' : ''}} {{!item.active ? 'inactive' : ''}}"
          bindtap="handleTapMember"
          data-openid="{{item.openId}}"
        >
          <image class="member-avatar" src="{{item.avatarUrlResolved}}" mode="aspectFill" />
          <view class="member-name">{{item.displayName}}</view>
          <view class="member-amount {{item.amount > 0 ? 'plus' : (item.amount < 0 ? 'minus' : 'zero')}}">
            {{item.amountText || '0'}}
          </view>
          <view wx:if="{{item.role === 'owner'}}" class="badge">房主</view>
          <view wx:if="{{!item.active}}" class="badge badge-gray">已退出</view>
        </view>
        <view wx:if="{{members.length === 0}}" class="subtle room-placeholder">授权并加入房间后显示成员列表</view>
      </view>
    </scroll-view>
  </view>

  <!-- 交易记录 -->
  <view class="card tx-card room-frame-card {{viewState !== 'in_room' ? 'room-frame-disabled' : ''}}">
    <view class="row-between">
      <view class="title">交易记录</view>
      <view class="subtle">{{txRows.length}} 笔</view>
    </view>

    <view wx:if="{{viewState !== 'in_room'}}" class="subtle room-placeholder" style="margin-top: 18rpx;">
      授权并加入房间后显示交易记录
    </view>

    <view wx:elif="{{txRows.length === 0}}" class="subtle" style="margin-top: 18rpx;">暂无记录</view>

    <scroll-view
      scroll-y
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
      scroll-into-view="{{txScrollIntoView}}"
      class="tx-list"
      lower-threshold="120"
      bindscrolltolower="handleTxListReachBottom"
      wx:else
    >
      <view class="tx-list-container">
        <view id="tx-list-top-anchor"></view>
        <view wx:for="{{txRows}}" wx:key="id" class="tx-item row-between">
          <view class="tx-body">
            <view class="tx-main">
              <image class="tx-inline-avatar" src="{{item.fromAvatarResolved}}" mode="aspectFill" />
              <text class="tx-name">{{item.fromName}}</text>
              <text class="tx-arrow"> → </text>
              <image class="tx-inline-avatar" src="{{item.toAvatarResolved}}" mode="aspectFill" />
              <text class="tx-name">{{item.toName}}</text>
            </view>
            <view class="subtle">{{item.timeText}}</view>
          </view>
          <view class="tx-amount">{{item.amountText}}</view>
        </view>
        <view class="tx-list-footer" wx:if="{{txLoadingMore}}">加载中...</view>
        <view class="tx-list-footer tx-list-footer-error" wx:elif="{{txLoadError}}">{{txLoadError}}</view>
        <view class="tx-list-footer" wx:elif="{{!txHasMore}}">没有更多记录了</view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 入房码弹层 -->
<view wx:if="{{viewState === 'in_room' && showJoinCode}}" class="overlay" bindtap="closeJoinCode">
  <view class="overlay-card" catchtap="noop">
    <view class="title">扫码加入</view>
    <image
      class="qrcode"
      src="{{joinCodeUrl}}"
      mode="aspectFit"
      show-menu-by-longpress="{{true}}"
      binderror="handleJoinCodeImageError"
      bindload="handleJoinCodeImageLoad"
    />
    <view class="subtle join-code-tip" wx:if="{{!joinCodeLoadError}}">
      长按图片可发送给朋友，好友识别后可加入当前房间。
    </view>
    <view class="subtle join-code-tip join-code-tip-error" wx:else>
      邀请码图加载失败，请稍后重试。
    </view>
    <button class="btn-primary" style="margin-top: 16rpx;" bindtap="closeJoinCode">关闭</button>
  </view>
</view>

<!-- 房主首次分享引导弹层 -->
<view wx:if="{{viewState === 'in_room' && showShareGuide}}" class="overlay" bindtap="closeShareGuide">
  <view class="overlay-card share-guide-card" catchtap="noop">
    <view class="title">邀请成员</view>
    <view class="subtle" style="margin-top: 12rpx;">
      点击上方“分享邀请”按钮，打开邀请码图后长按发送给朋友，即可邀请加入当前房间。
    </view>

    <view class="row share-guide-actions" style="margin-top: 22rpx;">
      <button class="btn-plain" style="flex: 1; margin-left: 14rpx;" bindtap="closeShareGuide">知道了</button>
    </view>
  </view>
</view>

<!-- 转账弹层 -->
<view wx:if="{{viewState === 'in_room' && showTransferModal}}" class="overlay" bindtap="closeTransferModal">
  <view class="overlay-card" catchtap="noop">
    <view class="title">转账</view>

    <view class="row" style="margin-top: 18rpx;">
      <image class="tx-avatar" src="{{transferToAvatarUrl}}" mode="aspectFill" />
      <view style="margin-left: 14rpx;">
        <view class="transfer-name">转给 {{transferToName}}</view>
        <view class="subtle">金额仅支持整数</view>
      </view>
    </view>

    <input
      class="input"
      type="number"
      placeholder="请输入金额"
      value="{{transferAmountText}}"
      bindinput="handleTransferAmountInput"
      maxlength="9"
      style="margin-top: 18rpx;"
      focus="{{showTransferModal}}"
    />

    <view class="row-between" style="margin-top: 18rpx;">
      <button class="btn-plain" style="flex: 1;" bindtap="closeTransferModal" disabled="{{isTransferSubmitting}}">取消</button>
      <button
        class="btn-primary"
        style="flex: 1; margin-left: 14rpx;"
        bindtap="confirmTransfer"
        disabled="{{isTransferSubmitting || !transferCanSubmit}}"
      >
        确认
      </button>
    </view>
  </view>
</view>
