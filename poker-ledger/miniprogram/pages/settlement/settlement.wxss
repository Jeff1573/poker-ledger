page {
  overflow: hidden;
}

.settlement-page {
  height: calc(100vh - 48rpx - constant(safe-area-inset-bottom));
  height: calc(100vh - 48rpx - env(safe-area-inset-bottom));
  overflow: hidden;
}

.settlement-container {
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.item-row {
  padding: 16rpx 0;
  border-bottom: 2rpx solid rgba(60, 60, 67, 0.12);
}

.item-row:last-child {
  border-bottom: none;
}

.leaderboard-btn {
  margin-left: 20rpx;
}

.leaderboard-card {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.leaderboard-scroll {
  margin-top: 18rpx;
  flex: 1;
  min-height: 0;
}

.leaderboard-scroll-inner {
  min-height: 100%;
  display: flex;
  flex-direction: column;
}

.leaderboard-list {
  flex-shrink: 0;
}

.leaderboard-footer {
  margin-top: 12rpx;
  text-align: center;
}

.leaderboard-bottom-spacer {
  height: calc(24rpx + constant(safe-area-inset-bottom));
  height: calc(24rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.rank {
  width: 84rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #687974;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #E8E1D2;
}

.name-wrap {
  margin-left: 14rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.right-wrap {
  text-align: right;
}

.rate {
  font-size: 30rpx;
  font-weight: 700;
  color: #236F5D;
}

.badge {
  display: inline-block;
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: rgba(35, 111, 93, 0.12);
  color: #236F5D;
}

.amount {
  font-size: 34rpx;
  font-weight: 700;
}

.plus {
  color: #2E8B73;
}

.minus {
  color: #C93B2E;
}

.zero {
  color: #687974;
}
