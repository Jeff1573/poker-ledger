<view class="container home-page">
  <!-- 顶部：一句话说明 + 环境标识（一眼看出连的是哪个后端） -->
  <view class="hero">
    <view class="hero-glow"></view>

    <view class="row-between hero-head">
      <view class="hero-title-wrap">
        <view class="hero-title">打牌记账</view>
        <view class="hero-sub">开房记账，扫码或输房间号即可加入</view>
      </view>

      <view class="env-pill env-pill--{{envTone}} home-env">
        <view class="env-dot"></view>
        <text class="env-text">{{envLabel}}</text>
      </view>
    </view>

    <view class="hero-env-detail">{{envDetail}}</view>
  </view>

  <!-- ① 身份区：未设置资料时，头像与昵称在同一步完成 -->
  <view class="card identity-card">
    <block wx:if="{{hasProfile}}">
      <view class="identity-row">
        <user-avatar class="identity-avatar" src="{{userAvatarUrl}}" name="{{user.displayName}}" size="{{104}}" />

        <view class="identity-main">
          <view class="identity-name">{{user.displayName}}</view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="identity-title">设置头像和昵称</view>
      <view class="identity-hint">只设置一次，用于房间里区分是谁的账</view>

      <view class="setup-row">
        <!-- 头像按钮直接触发微信头像选择，不再经过中间弹窗 -->
        <button
          class="avatar-trigger"
          open-type="chooseAvatar"
          bindchooseavatar="handleChooseAvatar"
          disabled="{{loading}}"
        >
          <user-avatar src="{{draftAvatarLocal}}" name="{{draftDisplayName}}" size="{{112}}" bordered="{{true}}" />
          <view class="avatar-trigger-text">{{draftAvatarPath ? '已选好' : (avatarUploading ? '上传中' : '选头像')}}</view>
        </button>

        <view class="setup-fields">
          <input
            class="input setup-input"
            type="nickname"
            placeholder="输入昵称"
            value="{{draftDisplayName}}"
            bindinput="handleNicknameInput"
            maxlength="20"
            disabled="{{loading}}"
          />
          <view class="setup-tip">昵称可直接用默认值，也能改成自己的</view>
        </view>
      </view>

      <!-- supportChooseAvatar 为 false 时走老版本基础库的兜底授权 -->
      <button
        wx:if="{{supportChooseAvatar}}"
        class="btn-primary setup-save"
        bindtap="handleSaveProfile"
        disabled="{{!canSaveProfile || loading}}"
      >
        完成
      </button>
      <button
        wx:else
        class="btn-primary setup-save"
        bindtap="handleAuthLegacy"
        disabled="{{loading}}"
      >
        使用微信授权获取
      </button>
    </block>
  </view>

  <!-- ② 房间区：已在房间时只给「回到房间」；不在房间时给「创建 / 加入」 -->
  <view wx:if="{{inRoom}}" class="card room-active">
    <view class="room-active-head">
      <view>
        <view class="room-active-label">当前房间</view>
        <view class="room-active-code">{{activeRoomCode}}</view>
      </view>
      <view class="role-pill">{{activeRoomIsOwner ? '房主' : '成员'}}</view>
    </view>

    <view class="room-active-hint">
      {{activeRoomIsOwner ? '你是房主，回房间继续记账或解散房间' : '已在房间中，回房间继续记账；换房需先退出'}}
    </view>

    <view class="room-active-actions">
      <button class="btn-primary room-active-main" bindtap="handleContinueRoom" disabled="{{loading}}">
        回到房间
      </button>
      <button
        wx:if="{{!activeRoomIsOwner}}"
        class="btn-plain room-active-side"
        bindtap="handleLeaveCurrentRoom"
        disabled="{{loading}}"
      >
        退出房间
      </button>
    </view>
  </view>
  <view wx:else class="card room-enter">
    <view class="room-enter-title">开始一局</view>

    <!-- 主次双卡：扫码是主入口（更宽、实底），创建房间为次入口 -->
    <view class="entry-grid">
      <view
        class="entry-card entry-card-main {{(!hasProfile || loading) ? 'entry-card-off' : ''}}"
        hover-class="{{(!hasProfile || loading) ? 'none' : 'entry-card-hover'}}"
        bindtap="handleScanJoin"
      >
        <view class="entry-icon"><view class="icon-scan"></view></view>
        <view class="entry-name">扫码加入</view>
        <view class="entry-sub entry-sub-main">最常见的入口</view>
      </view>

      <view
        class="entry-card entry-card-side {{(!hasProfile || loading) ? 'entry-card-off' : ''}}"
        hover-class="{{(!hasProfile || loading) ? 'none' : 'entry-card-hover'}}"
        bindtap="handleCreateRoom"
      >
        <view class="entry-icon"><view class="icon-plus"></view></view>
        <view class="entry-name">创建房间</view>
        <view class="entry-sub">我来当房主</view>
      </view>
    </view>

    <view wx:if="{{showCodeInput}}" class="code-row">
      <input
        class="input code-input"
        placeholder="输入房间号"
        value="{{roomCodeInput}}"
        bindinput="handleRoomCodeInput"
        confirm-type="go"
        bindconfirm="handleJoinRoom"
        maxlength="8"
        disabled="{{!hasProfile || loading}}"
      />
      <button class="btn-primary code-btn" bindtap="handleJoinRoom" disabled="{{!hasProfile || loading}}">
        加入
      </button>
    </view>
    <view wx:else class="code-toggle" bindtap="handleToggleCodeInput">已有房间号？手动输入</view>
  </view>

  <!-- ④ 次要入口：不抢占主操作视线 -->
  <view class="quick-links">
    <view class="quick-link" hover-class="quick-link-hover" bindtap="goLeaderboard">
      <view class="quick-link-title">总排行榜</view>
      <view class="quick-link-sub">历史战绩排名</view>
    </view>
    <view class="quick-link" hover-class="quick-link-hover" bindtap="goTimeline">
      <view class="quick-link-title">历史记录</view>
      <view class="quick-link-sub">往期结算明细</view>
    </view>
  </view>
</view>
