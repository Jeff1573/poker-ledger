/* 组件根节点：作为 flex 子项时保持自身尺寸不被压缩 */
:host {
  display: inline-block;
  flex-shrink: 0;
  vertical-align: middle;
}

.ua {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E8E1D2;
}

.ua-bordered {
  border: 2rpx solid rgba(35, 111, 93, 0.16);
  box-sizing: border-box;
}

.ua-img {
  width: 100%;
  height: 100%;
  display: block;
}

.ua-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0;
  user-select: none;
}
